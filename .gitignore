# MATLAB-generated build and cache files
slprj/
codegen/
*_rtw/
*.slxc
*.mex*

# Generated simulation results; keep the supplied RL policy
/data/*
!/data/trained_rl.mat

# Figures are regenerated by run_model.mlx
/figures/*
!/figures/.gitkeep

# Local exports and manuscript-only plotting
/run_model.m
/temp.m

# Editor backups and temporary files
*.asv
*.autosave
*.slx.autosave
*.slx.r20*
*.m~
*.mlx~
matlab_crash_dump*
*.dmp
*.log
*.tmp

# Local operating-system files
Thumbs.db
.DS_Store
